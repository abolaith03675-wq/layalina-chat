{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible profile for a Layali voice chat user (strictly non-PII).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique user ID matching Firebase Auth UID."
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Display nickname shown in rooms."
        },
        "avatar": {
          "type": "string",
          "maxLength": 200000,
          "description": "User avatar URL or compressed image data URL."
        },
        "role": {
          "type": "string",
          "enum": ["owner", "vip", "admin", "super_admin", "member", "guest"],
          "description": "Default global role badge."
        },
        "countryCode": {
          "type": "string",
          "maxLength": 10,
          "description": "ISO or country tab code."
        },
        "flag": {
          "type": "string",
          "maxLength": 16,
          "description": "Emoji country flag."
        },
        "level": {
          "type": "number",
          "description": "User experience level."
        },
        "coins": {
          "type": "number",
          "description": "Virtual coins balance for gifts."
        },
        "giftsReceivedCount": {
          "type": "number",
          "description": "Total gifts received."
        },
        "textColor": {
          "type": "string",
          "maxLength": 20,
          "description": "Preferred chat text hex color."
        },
        "mood": {
          "type": "string",
          "maxLength": 120,
          "description": "Short bio or status message."
        },
        "birthDate": {
          "type": "string",
          "maxLength": 20,
          "description": "Birth date string (YYYY-MM-DD)."
        },
        "isPrivateChatLocked": {
          "type": "boolean",
          "description": "Whether incoming private messages are blocked."
        },
        "isSoundEffectsMuted": {
          "type": "boolean",
          "description": "Whether room UI sound effects (alerts, messages, gifts) are muted while mic audio stays audible."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Public visibility flag for directory queries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "username",
        "avatar",
        "role",
        "countryCode",
        "flag",
        "level",
        "coins",
        "giftsReceivedCount",
        "textColor",
        "mood",
        "isPrivateChatLocked",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateData": {
      "title": "UserPrivateData",
      "description": "Isolated PII and security settings for a user, readable only by the owner or admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Matches Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "maxLength": 150,
          "description": "Verified account email address."
        },
        "profilePin": {
          "type": "string",
          "maxLength": 20,
          "description": "User's profile lock PIN code."
        },
        "deviceId": {
          "type": "string",
          "maxLength": 64,
          "description": "Generated device identifier."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": ["id", "email", "profilePin", "deviceId", "createdAt", "updatedAt"]
    },
    "Room": {
      "title": "Room",
      "description": "A live voice and text chat room with mic stage, master configuration, and quotas.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Room document ID."
        },
        "code": {
          "type": "string",
          "maxLength": 16,
          "description": "Numeric room display code."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Display title of the room."
        },
        "category": {
          "type": "string",
          "maxLength": 32,
          "description": "Country or entertainment category."
        },
        "countryName": {
          "type": "string",
          "maxLength": 40,
          "description": "Arabic country label."
        },
        "countryKeywords": {
          "type": "array",
          "description": "Searchable Arabic/English keywords (max 20)."
        },
        "flag": {
          "type": "string",
          "maxLength": 16,
          "description": "Room flag emoji."
        },
        "description": {
          "type": "string",
          "maxLength": 300,
          "description": "Room bio/description."
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Room Master display name."
        },
        "ownerAvatar": {
          "type": "string",
          "maxLength": 200000,
          "description": "Room Master avatar URL."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Display ID of the assigned room master."
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the creator/owner."
        },
        "masterPinCode": {
          "type": "string",
          "maxLength": 16,
          "description": "4-digit PIN for Master entrance."
        },
        "occupantsCount": {
          "type": "number",
          "description": "Live count of occupants inside the room."
        },
        "maxCapacity": {
          "type": "number",
          "description": "Maximum allowed concurrent occupants."
        },
        "isLocked": {
          "type": "boolean",
          "description": "Whether room requires password for guests."
        },
        "password": {
          "type": "string",
          "maxLength": 40,
          "description": "Optional room lock password."
        },
        "welcomeMessage": {
          "type": "string",
          "maxLength": 300,
          "description": "Room marquee welcome banner."
        },
        "activeSpeakerId": {
          "type": "string",
          "maxLength": 128,
          "description": "UID of current speaker on mic or empty string when free."
        },
        "speakerStartedAtMs": {
          "type": "number",
          "description": "Epoch milliseconds when current speaker took the mic."
        },
        "isMicTimerPaused": {
          "type": "boolean",
          "description": "When true, the current speaker mic countdown is paused/pinned."
        },
        "micPausedRemainingSec": {
          "type": "number",
          "description": "Remaining mic seconds saved when countdown is paused."
        },
        "micQueue": {
          "type": "array",
          "description": "Ordered list of user IDs waiting for mic (max 50)."
        },
        "isGoldName": {
          "type": "boolean",
          "description": "Gold room title highlight."
        },
        "validityDays": {
          "type": "number",
          "description": "Room validity duration in days."
        },
        "expiresAt": {
          "type": "string",
          "maxLength": 40,
          "description": "ISO 8601 expiration date string."
        },
        "expiresAtMs": {
          "type": "number",
          "description": "Exact expiration timestamp in epoch milliseconds."
        },
        "isActive": {
          "type": "boolean",
          "description": "Active activation status; automatically becomes false upon expiration."
        },
        "roleQuotas": {
          "type": "object",
          "description": "Maximum allowed ranked credentials per role."
        },
        "micDurations": {
          "type": "object",
          "description": "Configured mic speaking duration in seconds per user role."
        },
        "mutedUserIds": {
          "type": "array",
          "description": "List of muted user UIDs (max 200)."
        },
        "isMicLocked": {
          "type": "boolean",
          "description": "When true, mic is restricted to staff."
        },
        "reportsAllowedUsers": {
          "type": "array",
          "description": "List of ranked user IDs or usernames permitted by the Master to view Supervisor Reports (max 100)."
        },
        "reportsAllowedRoles": {
          "type": "array",
          "description": "List of non-owner rank keys permitted by the Master to view Supervisor Reports (max 6)."
        },
        "activeVideoStream": {
          "type": "object",
          "description": "Active live stream state object or null."
        },
        "micSessionId": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier for the active speaker WebRTC audio session."
        },
        "lastKickEvent": {
          "type": "object",
          "description": "Most recent immediate kick notification payload or null."
        },
        "lastBroadcastEvent": {
          "type": "object",
          "description": "Most recent global real-time broadcast event visible to all room occupants in the alert bar."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Visibility flag for lobby queries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "code",
        "name",
        "category",
        "countryName",
        "flag",
        "description",
        "ownerName",
        "ownerAvatar",
        "ownerId",
        "ownerUid",
        "occupantsCount",
        "maxCapacity",
        "isLocked",
        "welcomeMessage",
        "micQueue",
        "isMicLocked",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    },
