  "firestore": {
    "/users_public/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public user profiles (non-PII) keyed by client UID."
    },
    "/users_public/{userId}/inbox/{chatId}": {
      "schema": { "$ref": "#/entities/UserInboxChat" },
      "description": "Per-user index of active 1-to-1 private chat conversations."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateData" },
      "description": "Private PII and security PINs keyed by Firebase Auth UID."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/Room" },
      "description": "Voice chat rooms directory and live stage state."
    },
    "/rooms/{roomId}/participants/{participantId}": {
      "schema": { "$ref": "#/entities/RoomParticipant" },
      "description": "Real-time online users currently inside the room."
    },
    "/rooms/{roomId}/credentials/{credId}": {
      "schema": { "$ref": "#/entities/RoomCredential" },
      "description": "Assigned rank PINs for the room."
    },
    "/rooms/{roomId}/bans/{banId}": {
      "schema": { "$ref": "#/entities/RoomBan" },
      "description": "Banned users in the room."
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/RoomMessage" },
      "description": "Real-time room chat stream."
    },
    "/rooms/{roomId}/reports/{reportId}": {
      "schema": { "$ref": "#/entities/RoomReport" },
      "description": "User-submitted abuse reports for moderation compliance."
    },
    "/rooms/{roomId}/logs/{logId}": {
      "schema": { "$ref": "#/entities/RoomLog" },
      "description": "Chronological room entry and exit logs."
    },
    "/rooms/{roomId}/broadcasts/{broadcastId}": {
      "schema": { "$ref": "#/entities/RoomBroadcast" },
      "description": "Real-time global broadcast events visible to all room occupants simultaneously."
    },
    "/rooms/{roomId}/supervisor_reports/{reportId}": {
      "schema": { "$ref": "#/entities/SupervisorReport" },
      "description": "Supervisor administrative activity reports inside the room."
    },
    "/rooms/{roomId}/webrtc_signals/{signalId}": {
      "schema": { "$ref": "#/entities/WebRtcSignal" },
      "description": "Ephemeral WebRTC signaling documents for live voice room mic audio streaming."
    },
    "/private_chats/{chatId}": {
      "schema": { "$ref": "#/entities/PrivateConversation" },
      "description": "1-to-1 private chat conversation metadata."
    },
    "/private_chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/PrivateMessage" },
      "description": "Messages inside a 1-to-1 private conversation."
    }
  }
}
